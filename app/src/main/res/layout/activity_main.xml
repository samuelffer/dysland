<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:paddingBottom="40dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_1" android:textSize="11sp" android:textColor="#CAEF80" android:letterSpacing="0.18" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_2" android:textSize="38sp" android:textColor="#F4F6FA" android:fontFamily="@font/manrope" android:textStyle="bold" android:lineSpacingExtra="2dp" android:layout_marginTop="20dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_3" android:textSize="15sp" android:textColor="#9CA6B6" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:layout_marginTop="16dp" android:background="@drawable/hero">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_4" android:textSize="10sp" android:textColor="#CAEF80" android:letterSpacing="0.08" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_5" android:textSize="24sp" android:textColor="#F4F6FA" android:layout_marginTop="12dp" android:textStyle="bold" />
            <Space android:layout_width="1dp" android:layout_height="24dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/island" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_island" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/activity_main_6" android:textColor="#F4F6FA" android:textSize="13sp" android:gravity="center" />
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_music" android:importantForAccessibility="no" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_7" android:textSize="11sp" android:textColor="#B3C3AB" android:layout_marginTop="16dp" />
            <Button android:id="@+id/enable" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/pill" android:backgroundTint="#CAEF80" android:text="@string/activity_main_8" android:textAllCaps="false" android:textSize="14sp" android:textColor="#15200D" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_9" android:textSize="12sp" android:textColor="#B3C3AB" android:id="@+id/service_status" android:layout_marginTop="10dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:layout_marginTop="16dp" android:background="@drawable/card">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_shield" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_10" android:textSize="22sp" android:textColor="#F4F6FA" android:textStyle="bold" android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_11" android:textSize="13sp" android:textColor="#9CA6B6" android:layout_marginTop="6dp" />
            <Button android:id="@+id/overlay_permission" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/chip" android:backgroundTint="#242A34" android:text="@string/activity_main_12" android:textAllCaps="false" android:textSize="14sp" android:textColor="#F4F6FA" />
            <Button android:id="@+id/notification_permission" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/chip" android:backgroundTint="#242A34" android:text="@string/activity_main_13" android:textAllCaps="false" android:textSize="14sp" android:textColor="#F4F6FA" />
            <Button android:id="@+id/post_permission" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/chip" android:backgroundTint="#242A34" android:text="@string/activity_main_14" android:textAllCaps="false" android:textSize="14sp" android:textColor="#F4F6FA" />
            <Button android:id="@+id/bluetooth_permission" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/chip" android:backgroundTint="#242A34" android:text="@string/activity_main_15" android:textAllCaps="false" android:textSize="14sp" android:textColor="#F4F6FA" />
            <Button android:id="@+id/battery_settings" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/chip" android:backgroundTint="#242A34" android:text="@string/activity_main_16" android:textAllCaps="false" android:textSize="14sp" android:textColor="#F4F6FA" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#CAEF80" android:id="@+id/permissions_status" android:layout_marginTop="12dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:layout_marginTop="16dp" android:background="@drawable/card">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_settings" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_17" android:textSize="22sp" android:textColor="#F4F6FA" android:textStyle="bold" android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_18" android:textSize="13sp" android:textColor="#9CA6B6" android:layout_marginTop="6dp" />
            <Spinner android:id="@+id/preset" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:contentDescription="@string/activity_main_19" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_20" android:textSize="14sp" android:textColor="#F4F6FA" android:layout_marginTop="16dp" />
            <SeekBar android:id="@+id/width" android:layout_width="match_parent" android:layout_height="48dp" android:max="180" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_21" android:textSize="14sp" android:textColor="#F4F6FA" android:layout_marginTop="16dp" />
            <SeekBar android:id="@+id/top" android:layout_width="match_parent" android:layout_height="48dp" android:max="100" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_22" android:textSize="14sp" android:textColor="#F4F6FA" android:layout_marginTop="16dp" />
            <SeekBar android:id="@+id/offset" android:layout_width="match_parent" android:layout_height="48dp" android:max="200" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_23" android:textSize="14sp" android:textColor="#F4F6FA" android:layout_marginTop="16dp" />
            <SeekBar android:id="@+id/height" android:layout_width="match_parent" android:layout_height="48dp" android:max="40" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#CAEF80" android:id="@+id/geometry_label" />
            <Switch android:id="@+id/hide_lock" android:layout_width="match_parent" android:layout_height="60dp" android:text="@string/activity_main_24" android:textSize="16sp" android:textColor="#F4F6FA" android:switchMinWidth="52dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_25" android:textSize="12sp" android:textColor="#9CA6B6" />
            <Switch android:id="@+id/show_idle" android:layout_width="match_parent" android:layout_height="60dp" android:text="@string/activity_main_26" android:textSize="16sp" android:textColor="#F4F6FA" android:switchMinWidth="52dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_27" android:textSize="12sp" android:textColor="#9CA6B6" />
            <Switch android:id="@+id/show_content" android:layout_width="match_parent" android:layout_height="60dp" android:text="@string/activity_main_28" android:textSize="16sp" android:textColor="#F4F6FA" android:switchMinWidth="52dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_29" android:textSize="12sp" android:textColor="#9CA6B6" />
            <Button android:id="@+id/reset_geometry" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/chip" android:backgroundTint="#242A34" android:text="@string/activity_main_30" android:textAllCaps="false" android:textSize="14sp" android:textColor="#F4F6FA" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:layout_marginTop="16dp" android:background="@drawable/card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_31" android:textSize="22sp" android:textColor="#F4F6FA" android:textStyle="bold" />
            <Switch android:id="@+id/media_enabled" android:layout_width="match_parent" android:layout_height="60dp" android:text="@string/activity_main_32" android:textSize="16sp" android:textColor="#F4F6FA" android:switchMinWidth="52dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_33" android:textSize="12sp" android:textColor="#9CA6B6" />
            <Switch android:id="@+id/events_enabled" android:layout_width="match_parent" android:layout_height="60dp" android:text="@string/activity_main_34" android:textSize="16sp" android:textColor="#F4F6FA" android:switchMinWidth="52dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_35" android:textSize="12sp" android:textColor="#9CA6B6" />
            <Switch android:id="@+id/notifications_enabled" android:layout_width="match_parent" android:layout_height="60dp" android:text="@string/activity_main_36" android:textSize="16sp" android:textColor="#F4F6FA" android:switchMinWidth="52dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_37" android:textSize="12sp" android:textColor="#9CA6B6" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:layout_marginTop="16dp" android:background="@drawable/card">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_timer" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_38" android:textSize="22sp" android:textColor="#F4F6FA" android:textStyle="bold" android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_39" android:textSize="13sp" android:textColor="#9CA6B6" />
            <EditText android:id="@+id/timer_minutes" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="number" android:maxLength="3" android:hint="@string/activity_main_40" android:textColor="#F4F6FA" android:textColorHint="#9CA6B6" android:importantForAutofill="no" />
            <Button android:id="@+id/timer_start" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/chip" android:backgroundTint="#242A34" android:text="@string/activity_main_41" android:textAllCaps="false" android:textSize="14sp" android:textColor="#F4F6FA" />
            <Button android:id="@+id/stopwatch_start" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/chip" android:backgroundTint="#242A34" android:text="@string/activity_main_42" android:textAllCaps="false" android:textSize="14sp" android:textColor="#F4F6FA" />
            <Button android:id="@+id/timer_stop" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/chip" android:backgroundTint="#242A34" android:text="@string/activity_main_43" android:textAllCaps="false" android:textSize="14sp" android:textColor="#F4F6FA" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:layout_marginTop="16dp" android:background="@drawable/card">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_info" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_44" android:textSize="20sp" android:textColor="#F4F6FA" android:textStyle="bold" android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_45" android:textSize="13sp" android:textColor="#9CA6B6" android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
