                        <Button android:id="@+id/demo_music" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" style="?android:attr/borderlessButtonStyle" android:text="@string/demo_music_text" android:textAllCaps="false" android:textSize="12sp" android:textColor="#554778" android:stateListAnimator="@animator/press_feedback" />
